# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────
# Local MongoDB or MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/caresure
# Production: mongodb+srv://<username>:<password>@cluster0.mongodb.net/caresure?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend / CORS ──────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ── AI service ───────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent as a header; must match ai-service
AI_SERVICE_TOKEN=replace_with_long_random_string
AI_TIMEOUT_MS=5000

# ── Demo ─────────────────────────────────────────────────
# Seed password for the demo reviewer; never reuse a real password
DEMO_USER_PASSWORD=CareSureDemo2026!

# ── Monitoring & Logging ─────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
