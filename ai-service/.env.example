# ── AI Service ────────────────────────────────────────────
# Shared secret that must match AI_SERVICE_TOKEN in the backend .env
AI_SERVICE_TOKEN=replace_with_long_random_string_matching_backend

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Model Artifacts ──────────────────────────────────────
# Relative path to the models directory (from ai-service/ root)
MODELS_DIR=./models
